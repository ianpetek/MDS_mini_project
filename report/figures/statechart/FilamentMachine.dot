digraph "FilamentMachine" {
  graph [rankdir=LR, compound=true, nodesep=0.45, ranksep=0.8, fontname="Times", fontsize=11, pad=0.1];
  node  [shape=box, style="rounded", fontname="Times", fontsize=11, margin="0.15,0.06"];
  edge  [fontname="Times", fontsize=9, arrowsize=0.7];
  "__init_FilamentMachine" [shape=point, width=0.1, label=""];
  "__init_FilamentMachine" -> "IDLE";
  "WIPING" [label="WIPING"];
  "MOVING_TO_WIPE" [label="MOVING TO WIPE"];
  "NOZZLE_COOLING" [label="NOZZLE COOLING"];
  "IDLE" [label="IDLE"];
  "NOZZLE_HEATING" [label="NOZZLE HEATING"];
  "LOADING_FILAMENT" [label="LOADING FILAMENT"];
  "READY_TO_RESUME" [label="READY TO RESUME"];
  "WIPING" -> "NOZZLE_COOLING" [label="after(p.t_wipe,sec)"];
  "MOVING_TO_WIPE" -> "WIPING" [label="duration(arrived)>0.5"];
  "IDLE" -> "MOVING_TO_WIPE" [label="hasChangedTo(C, 1) || F"];
  "NOZZLE_COOLING" -> "LOADING_FILAMENT" [label="~heated"];
  "NOZZLE_HEATING" -> "IDLE" [label="heated && ~paused"];
  "READY_TO_RESUME" -> "IDLE" [label="duration(arrived)>0.5"];
  "NOZZLE_HEATING" -> "READY_TO_RESUME" [label="heated && paused"];
  "LOADING_FILAMENT" -> "NOZZLE_HEATING" [label="after(p.t_load,sec)"];
}
