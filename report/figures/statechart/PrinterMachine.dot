digraph "PrinterMachine" {
  graph [rankdir=LR, compound=true, nodesep=0.45, ranksep=0.8, fontname="Times", fontsize=11, pad=0.1];
  node  [shape=box, style="rounded", fontname="Times", fontsize=11, margin="0.15,0.06"];
  edge  [fontname="Times", fontsize=9, arrowsize=0.7];
  "__init_PrinterMachine" [shape=point, width=0.1, label=""];
  "__init_PrinterMachine" -> "IDLE";
  "COMPLETED" [label="COMPLETED"];
  subgraph "cluster_IN_PROGRESS" {
    label="IN PROGRESS"; style="rounded"; fontname="Times"; fontsize=11; labeljust="l";
    "__init_IN_PROGRESS" [shape=point, width=0.1, label=""];
    "__init_IN_PROGRESS" -> "WAIT_HOT";
    "PRINT_PATH" [label="PRINT PATH"];
    "TRAVEL_TO_START" [label="TRAVEL TO START"];
    "WAIT_HOT" [label="WAIT HOT"];
  }
  "IDLE" [label="IDLE"];
  "FAILED" [label="FAILED"];
  "PAUSED" [label="PAUSED"];
  "PRINT_PATH" -> "FAILED" [label="at_wall"];
  "PRINT_PATH" -> "COMPLETED" [label="k == p.n_path &&
duration(arrived) > 0.5"];
  "IDLE" -> "WAIT_HOT" [label="START==1", lhead="cluster_IN_PROGRESS"];
  "TRAVEL_TO_START" -> "FAILED" [label="duration(arrived) > 0.5 &&
~failed"];
  "WAIT_HOT" -> "PAUSED" [label="hasChangedTo(PAUSE_RESUME, 1)
|| hasChangedTo(C, 1) || F", ltail="cluster_IN_PROGRESS"];
  "PAUSED" -> "WAIT_HOT" [label="(hasChangedTo(PAUSE_RESUME,
1) || change_done) &&
~change_active", lhead="cluster_IN_PROGRESS"];
  "PRINT_PATH" -> "PRINT_PATH" [label="k < p.n_path && arrived"];
  "TRAVEL_TO_START" -> "PRINT_PATH" [label="duration(arrived) > 0.5 &&
~failed"];
  "PRINT_PATH" -> "TRAVEL_TO_START" [label="at_wall"];
  "WAIT_HOT" -> "TRAVEL_TO_START" [label="heated"];
}
