digraph "Filament" {
  graph [rankdir=TB, compound=true, nodesep=0.5, ranksep=0.8, newrank=true, fontname="Times", fontsize=18, pad=0.15];
  node  [shape=box, style="rounded", fontname="Times", fontsize=18, margin="0.2,0.1"];
  edge  [fontname="Times", fontsize=15, arrowsize=0.8];
"init" [shape=point,width=0.12,label=""]; "init" -> "IDLE";
"IDLE" [label=<<B>IDLE</B>>];
"MOVING_TO_WIPE" [label=<<B>MOVING_TO_WIPE</B><BR/><FONT POINT-SIZE="14">motors on, extruder off<BR/>r = (<I>x</I><SUB><I>w</I></SUB>, <I>y</I><SUB><I>w</I></SUB>)</FONT>>];
"WIPING" [label=<<B>WIPING</B><BR/><FONT POINT-SIZE="14">motors on, extruder on<BR/>r = (<I>x</I><SUB><I>w</I></SUB> + 0.02, <I>y</I><SUB><I>w</I></SUB>)</FONT>>];
"NOZZLE_COOLING" [label=<<B>NOZZLE_COOLING</B><BR/><FONT POINT-SIZE="14">extruder off</FONT>>];
"LOADING_FILAMENT" [label=<<B>LOADING_FILAMENT</B>>];
"NOZZLE_HEATING" [label=<<B>NOZZLE_HEATING</B><BR/><FONT POINT-SIZE="14">extruder off</FONT>>];
"READY_TO_RESUME" [label=<<B>READY_TO_RESUME</B><BR/><FONT POINT-SIZE="14">motors on, extruder off<BR/>r = (<I>x</I><SUB><I>s</I></SUB>, <I>y</I><SUB><I>s</I></SUB>)</FONT>>];
"IDLE" -> "MOVING_TO_WIPE" [label=<C<SUP>&uarr;</SUP> &or; F<BR/><FONT POINT-SIZE="13">/ <I>change_active</I><SUP>+</SUP> = true, <I>change_done</I><SUP>+</SUP> = false</FONT>>];
"MOVING_TO_WIPE" -> "WIPING" [label=<<I>arr</I><SUB>&gt;0.5</SUB>>];
"WIPING" -> "NOZZLE_COOLING" [label=<<I>&tau;</I> &ge; <I>t</I><SUB><I>w</I></SUB><BR/><FONT POINT-SIZE="13">/ <I>req</I><SUP>+</SUP> = false</FONT>>];
"NOZZLE_COOLING" -> "LOADING_FILAMENT" [label=<&not;<I>heated</I>>];
"NOZZLE_HEATING" -> "LOADING_FILAMENT" [dir=back, label=<<I>&tau;</I> &ge; <I>t</I><SUB><I>l</I></SUB><BR/><FONT POINT-SIZE="13">/ <I>req</I><SUP>+</SUP> = true</FONT>>];
"READY_TO_RESUME" -> "NOZZLE_HEATING" [dir=back, label=<<I>heated</I> &and; <I>paused</I>>];
"IDLE" -> "READY_TO_RESUME" [dir=back, label=<<I>arr</I><SUB>&gt;0.5</SUB><BR/><FONT POINT-SIZE="13">/ <I>change_done</I><SUP>+</SUP> = true, <I>change_active</I><SUP>+</SUP> = false</FONT>>];
{rank=same; "MOVING_TO_WIPE"; "READY_TO_RESUME"}
{rank=same; "WIPING"; "NOZZLE_HEATING"}
{rank=same; "NOZZLE_COOLING"; "LOADING_FILAMENT"}
}
